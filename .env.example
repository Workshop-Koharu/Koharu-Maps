# =================================================================
# Koharu Maps — Production Environment Configuration
# Domain: https://map.koharu.live
# =================================================================

# 1. Base App URL (Production Custom Domain)
NEXT_PUBLIC_APP_URL=https://map.koharu.live

# 2. JWT Secret Key (Replace with a strong random string)
JWT_SECRET=koharu_maps_super_secret_production_key_2026

# 3. Supabase Database Configuration (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Resend Email Service (https://resend.com)
# Used for: 6-digit verification code, Welcome email, New Device/IP Security alert
RESEND_API_KEY=
RESEND_FROM_EMAIL=Koharu Maps <onboarding@resend.dev>

# 5. Google OAuth 2.0 (https://console.cloud.google.com)
# Redirect URI: https://map.koharu.live/api/auth/social/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. Discord OAuth 2.0 (https://discord.com/developers/applications)
# Redirect URI: https://map.koharu.live/api/auth/social/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 7. GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: https://map.koharu.live/api/auth/social/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
